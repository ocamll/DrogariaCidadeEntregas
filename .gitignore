# chaves geradas por scripts/gerar-chaves-offline.mjs — nunca commitar
.chaves-offline/

# cartões gerados — o ARQUIVO É O CARTÃO: quem tiver ele imprime uma cópia
# que funciona. Pega tanto o `cartao-de-teste.*` do script quanto o
# `cartao-<public_id>.*` que a tela de emissão baixa, caso alguém salve um
# aqui dentro. Ver "O arquivo do cartão" no CLAUDE.md.
cartao-*.pdf
cartao-*.svg

# romaneios de exemplo — `scripts/romaneio-de-exemplo.mts` os regenera a
# cada execução, com dado fictício. São para conferir DESENHO sem depender
# do banco, não artefato de build; commitá-los criaria um diff binário a
# cada vez que alguém roda o script.
romaneio-exemplo-*.pdf

# AGENTS.md — convenção que OUTRAS ferramentas de IA usam pra ler
# instruções de projeto (o Codex, da OpenAI, entre elas). O arquivo que
# apareceu aqui é uma cópia do CLAUDE.md, gerada fora das sessões de
# trabalho e já desatualizada quando nasceu. Fica de fora do repositório
# porque duas fontes de verdade é pior que uma: a fonte é o CLAUDE.md.
AGENTS.md

# Artefato intermediário do patch do E3.B — regenerado a cada execução
# de scripts/patch-selar-retorno-e3b.mts. A migration final está em
# supabase/migrations/, versionada; esta é só a etapa do meio.
scripts/.e3b-proposta.sql

# Artefato intermediário do patch do E10 — mesma disciplina do E3.B.
# A migration final é versionada; esta proposta existe só para provar o
# diff e as invariantes antes de o arquivo definitivo nascer.
scripts/.e10-proposta.sql

# graphify — o grafo de conhecimento do projeto (2026-09-08).
#
# O GRAFO É VERSIONADO, e isso é decisão: `graph.json`, `graph.html`,
# `GRAPH_REPORT.md` e `manifest.json` ficam no repositório, para quem
# clonar receber o índice pronto em vez de precisar reconstruí-lo — o que
# custaria a extração semântica de novo.
#
# O `manifest.json` é o que torna `graphify --update` incremental: ele
# guarda o hash de cada arquivo já processado. Sem ele versionado, o
# primeiro `--update` de outra máquina re-extrairia o corpus inteiro.
#
# Só sai daqui o que é local ou puramente regenerável:
graphify-out/cost.json
graphify-out/cache/

# `.graphifyignore` NÃO entra nesta lista — ele é versionado de
# propósito. É ele que mantém o NOTAS.md (490 KB, ~76 mil palavras) fora
# do índice, e essa exclusão precisa valer para todo mundo que clonar,
# não só para a máquina onde ela foi decidida.
# Caminhos absolutos DESTA máquina — o interpretador Python e a raiz do
# scan. São reescritos a cada execução e quebrariam em outro clone.
graphify-out/.graphify_python
graphify-out/.graphify_root
