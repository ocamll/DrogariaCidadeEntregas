VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ID do cliente OAuth do Google (identificador PUBLICO, nao e segredo).
# Usado so pra enviar o acerto ao Drive, escopo drive.file.
VITE_GOOGLE_CLIENT_ID=

# Chave publica que sela o PIN na fila offline (identificador PUBLICO, vai
# no bundle). Gerada por: node scripts/gerar-chaves-offline.mjs
# A privada correspondente e secret da Edge Function sincronizar-romaneio,
# em ROMANEIO_KEYS — nunca aqui.
VITE_ROMANEIO_KEY_ID=
VITE_ROMANEIO_PUBKEY=
